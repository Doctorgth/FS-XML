# Исключения PyCharm и IDE
.idea/
.vscode/
*.swp
*.sublime-project

# Виртуальное окружение Python
venv/
.venv/
env/
ENV/

# Кэш Python и компилированные файлы
__pycache__/
*.py[cod]
*$py.class

# Фронтенд (зависимости и артефакты сборки Vite)
node_modules/
frontend/dist/
.vite/
*.tsbuildinfo

# Локальная база данных приложения (включая SQLite WAL-файлы) и тестов
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite3
app_data.db

# Генерируемые дампы контекста и логи лаунчера
context_dump.txt
launcher_error.log

# Кэш pytest и тестирования
.pytest_cache/
.coverage
htmlcov/

# Системные файлы операционных систем
Thumbs.db
Desktop.ini
.DS_Store

# Переносимый локальный интерпретатор Python (Windows Embed) и папка сборки релиза
/python/
/release/